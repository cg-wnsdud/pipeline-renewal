   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0020",
   "bbox": [
    42,
    656,
    607,
    683
   ],
   "text": "·이 적금의 만기일 이전 중도해지한 경우 정부기여금을 받으실",
   "status": "verified",
   "from": "#21",
