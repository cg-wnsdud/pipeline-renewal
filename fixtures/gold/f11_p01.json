   "from": "#18",
   "legibility": "clear",
   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0018",
   "bbox": [
    40,
    583,
    628,
    609
   ],
   "text": "·만기 전 해지할 경우 계약한 이자율보다 낮은 중도해지이자율이",
   "status": "verified",
   "from": "#19",
   "legibility": "clear",
   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0019",
