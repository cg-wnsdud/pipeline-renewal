  {
   "id": "f11_p01-g0021",
   "bbox": [
    40,
    695,
    444,
    717
   ],
   "text": "수 없으며 비과세 혜택을 받으실 수 없습니다.",
   "status": "verified",
   "from": "#22",
   "legibility": "clear",
   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0022",
   "bbox": [
    41,
    731,
    583,
    755
   ],
