   "status": "verified",
   "from": "#24",
   "legibility": "clear",
   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0024",
   "bbox": [
    37,
    802,
    400,
    828
   ],
   "text": "①이적금의 만기일 이후해지한 가입자",
   "status": "verified",
   "from": "#25",
   "legibility": "clear",
   "optional": false,
   "note": ""
  },
  {
   "id": "f11_p01-g0025",
