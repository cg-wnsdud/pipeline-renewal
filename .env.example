# 이 파일을 .env 로 복사해 값을 채운다. 이미 설정된 환경변수가 우선한다. 산출물에 URL 을 기록하지 않는다.

# PaddleX PP-StructureV3 layout-parsing (클라이언트 동시 1)
PN_OCR_URL=http://HOST/paddlex/layout-parsing
PN_OCR_TIMEOUT_S=180

# VLM(문구 판독·긴 이미지 경계 판단·의미 단계)
PN_VLM_URL=http://HOST/llm/v1/chat/completions
PN_VLM_MODEL=MODEL_ALIAS

# HWP/HWPX → PDF: 기존 parser-pipeline 가상환경 python 과 프로젝트 경로(변환 함수만 호출)
PN_HWP_PYTHON=
PN_HWP_PROJECT=
# HWP_CHROMIUM=C:/Program Files/Google/Chrome/Application/chrome.exe

# 산출물 위치(기본 ./work)
# LP_WORK_DIR=
